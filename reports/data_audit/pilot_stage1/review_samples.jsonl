ing_weight": null}
{"flag": "possible_title_body_mismatch", "inclusion_probability": null, "record": {"block_state": "valid", "blocks_text_match": true, "disposition": "needs_review", "doc_id": 1406325, "doc_id_raw": "1406325", "doc_type_hint": "structured_article_candidate", "domain": "cnkang.com", "flags": ["possible_title_body_mismatch"], "has_recovery_material": true, "html_chars": 0, "html_state": "empty", "html_visible_chars": 0, "language_hint": "cjk_likely_zh", "metadata": {"abstract": {"origin": "unknown", "preview": null, "state": "missing_column"}, "authors": {"origin": "unknown", "preview": null, "state": "missing_column"}, "canonical": {"origin": "existing_column", "preview": null, "state": "empty"}, "category": {"origin": "unknown", "preview": null, "state": "missing_column"}, "desc": {"origin": "existing_column", "preview": "幽门螺杆菌（H pylori，Hp）感染与多种疾病相关，包括胃炎及胃腺癌。关于 Hp 清除是否可预防癌症，还是仅降低其发病风险，目前还无明确的结论。此外，有研究", "state": "present"}, "html_candidates": {"meta": {}, "origin": "html_meta_or_jsonld", "structured_fields": []}, "method": {"origin": "existing_column", "preview": "dense", "state": "present"}, "published_date": {"origin": "unknown", "preview": null, "state": "missing_column"}, "source": {"origin": "existing_column", "preview": "live", "state": "present"}, "title": {"origin": "existing_column", "preview": "幽门螺杆菌综述：如何清除是关键(转载)_中华康网", "state": "present"}, "ts": {"origin": "existing_column", "preview": "1792716465", "state": "present"}, "updated_date": {"origin": "unknown", "preview": null, "state": "missing_column"}}, "n_blocks": 46, "n_chars": 4783, "n_lines": 46, "n_ws_tokens": 218, "normalized_sha256": "4a0ff17f10fae28b75471182e6b44cce60271296749cf14cd56cf6da8221677a", "reasons": ["possible_title_body_mismatch"], "record_id": "f7bf70c4d9f12bf013bdfc2765ee2f3eb634edc9b7c13a425898948c4b3142a4", "review_status": "unreviewed", "row_group": 0, "row_offset": 41, "script_ratios": {"ascii_latin": 275, "cjk": 3890, "confidence": "heuristic_only", "letters": 4166, "scope": "entire_text", "vi_diacritic_chars": 0}, "shard": "ViBioMIR/shards/C/cnkang.com/part-1792716526532-236.parquet", "signals": {"gate": {"count": 0, "examples": []}, "negation": {"count": 5, "examples": [{"end": 71, "start": 70, "text": "无"}, {"end": 468, "start": 467, "text": "无"}, {"end": 1147, "start": 1146, "text": "无"}, {"end": 2409, "start": 2407, "text": "没有"}, {"end": 2768, "start": 2767, "text": "无"}]}, "number_unit": {"count": 9, "examples": [{"end": 337, "start": 335, "text": "3%"}, {"end": 340, "start": 338, "text": "5%"}, {"end": 1202, "start": 1200, "text": "1%"}, {"end": 1209, "start": 1207, "text": "4%"}, {"end": 2853, "start": 2850, "text": "95%"}, {"end": 2883, "start": 2880, "text": "90%"}, {"end": 3058, "start": 3055, "text": "90%"}, {"end": 3067, "start": 3064, "text": "95%"}]}, "ui": {"count": 0, "examples": []}}, "snippet": "胃炎\n幽门螺杆菌（H pylori，Hp）感染与多种疾病相关，包括胃炎及胃腺癌。关于 Hp 清除是否可预防癌症，还是仅降低其发病风险，目前还无明确的结论。此外，有研究提出幽门螺杆菌感染对机体还可能有一定益处（如降低肥胖或儿童哮喘的风险等），但证据也尚不充分。四川省第四人民医院消化内科常玉英\n近期发表于 Gastroenterology 的一篇综述，回顾了 Hp 感染带来的影响，并对清除 Hp 带来的益处和挑战进行了总结。\n一、Hp：胃癌的首要病因\nHp 感染是胃癌的首要病因，但该细菌本身还不足以引发胃癌，需要其他因素的参与，且 Hp 并不是胃癌的唯一病因，Epstein-Barr 病毒感染、宿主基因异常、自身免疫性胃炎以及食管腺癌相关近端癌症等，也占了胃腺癌的 3%-5%。因此，即使不存在 Hp 感染，胃腺癌也不会完全消失。\n胃癌是全世界癌症死亡的主要原因。2014 年 11 月，WHO 发表了一篇题为《幽门螺杆菌根除作为预防胃癌的措施》的工作报告。2015 年初发表了关于 Hp 性胃炎的京都全球共识意见。\n该意见指出，无论病人是否出现症状，也不论是否有消化性溃疡和胃癌等并发症，胃炎应该被定义为一种传染病；Hp 感染者应给予根除治疗，除非患者本身的状况不允许；消灭 Hp 可降低胃癌的风险。风险降低的程度取决于细菌感染的时间、感染的严重程度以及萎缩性损伤的程度。\n总之，目前的问题是如", "snippet_origin": "text", "source_sha256": "dd3b58dea0f4314f7660391779afad4db88425eb202556bd8511d5ed6aca994b", "status": "200", "structure": {"block_kinds": {"h": 1, "p": 45}, "html": {"chars": 0, "state": "empty", "visible_chars": 0}, "repeated_lines": 0, "title_body_word_overlap": 0.0}, "text_state": "present", "url": "http://www.cnkang.com/dise/1/387809.html", "verbatim_sha256": "72e04f2bec1d31ca8eb9cb55311a987269a42418831ae604f4f3bcf547229859"}, "sample_kind": "targeted_flag_example", "sampling_weight": null}
{"flag": "possible_title_body_mismatch", "inclusion_probability": null, "record": {"block_state": "valid", "blocks_text_match": true, "disposition": "needs_review", "doc_id": 1409299, "doc_id_raw": "1409299", "doc_type_hint": "structured_article_candidate", "domain": "cnkang.com", "flags": ["possible_title_body_mismatch"], "has_recovery_material": true, "html_chars": 0, "html_state": "empty", "html_visible_chars": 0, "language_hint": "cjk_likely_zh", "metadata": {"abstract": {"origin": "unknown", "preview": null, "state": "missing_column"}, "authors": {"origin": "unknown", "preview": null, "state": "missing_column"}, "canonical": {"origin": "existing_column", "preview": null, "state": "empty"}, "category": {"origin": "unknown", "preview": null, "state": "missing_column"}, "desc": {"origin": "existing_column", "preview": "精神发育迟滞（mental retardation，ＭＲ）又称智力低下或智力残疾（intellectual disability），是指个体在发育时期内（18岁", "state": "present"}, "html_candidates": {"meta": {}, "origin": "html_meta_or_jsonld", "structured_fields": []}, "method": {"origin": "existing_column", "preview": "dense", "state": "present"}, "published_date": {"origin": "unknown", "preview": null, "state": "missing_column"}, "source": {"origin": "existing_column", "preview": "live", "state": "present"}, "title": {"origin": "existing_column", "preview": "全面了解智力低下，做到早发现、早诊断、早干预、科学管理_中华康网", "state": "present"}, "ts": {"origin": "existing_column", "preview": "1792716472", "state": "present"}, "updated_date": {"origin": "unknown", "preview": null, "state": "missing_column"}}, "n_blocks": 20, "n_chars": 1916, "n_lines": 20, "n_ws_tokens": 26, "normalized_sha256": "8ebe95589b13d394faafb780447bf62ef8a412b27890910e57baa689eee8643b", "reasons": ["possible_title_body_mismatch"], "record_id": "70e08e32551b0b9bb50a7f649e05f9c877fec43ffc684a2865d77ff99b76f684", "review_status": "unreviewed", "row_group": 0, "row_offset": 133, "script_ratios": {"ascii_latin": 71, "cjk": 1552, "confidence": "heuristic_only", "letters": 1633, "scope": "entire_text", "vi_diacritic_chars": 0}, "shard": "ViBioMIR/shards/C/cnkang.com/part-1792716526532-236.parquet", "signals": {"gate": {"count": 0, "examples": []}, "negation": {"count": 1, "examples": [{"end": 1208, "start": 1207, "text": "无"}]}, "number_unit": {"count": 6, "examples": [{"end": 222, "start": 220, "text": "3%"}, {"end": 247, "start": 245, "text": "2%"}, {"end": 266, "start": 264, "text": "2%"}, {"end": 276, "start": 274, "text": "7%"}, {"end": 284, "start": 282, "text": "4%"}, {"end": 658, "start": 655, "text": "50%"}]}, "ui": {"count": 0, "examples": []}}, "snippet": "智力障碍\n精神发育迟滞（mental retardation，ＭＲ）又称智力低下或智力残疾（intellectual disability），是指个体在发育时期内（18岁以前），一般智力功能明显低于同龄水平，同时伴有适应行为的缺陷。\n精神发育迟滞是遍及全世界的导致人类残疾最为重要的原因之一，严重危害儿童身心健康，给社会和家庭带来沉重的负担。青岛市妇女儿童医院小儿康复科侯梅\nＷＨＯ报道世界任何国家、任何民族的精神发育迟滞患病率不低于1%～3%，各国流行病学调查的精神发育迟滞患病率为1%～2%。我国儿童精神发育迟滞患病率为1.2%，其中城市为0.7%，农村为1.4%，边远山区更高。\n一、病因\n精神发育迟滞的病因包括生物医学因素和社会心理文化因素两个方面。ＷＨＯ对精神发育迟滞的病因分类为：①感染、中毒；②脑机械损伤、缺氧；③代谢、营养、内分泌因素；④肉眼可视的脑部疾病；⑤先天脑畸形及其综合征；⑥染色体病；⑦围生期因素；⑧伴发于精神病；⑨社会心理因素；⑩特殊感官缺陷及其它因素。\n从精神发育迟滞病因作用的时间来看,可分为产前、产时和产后三个时期。其中产前因素包括染色体异常、遗传代谢病、先天畸形、宫内感染、宫内窒息、母孕期接触有害理化因素、孕妇患严重疾病等；产时因素包括窒息、颅内出血、产伤等；产后因素包括早产、低体重儿、未成熟儿、颅内感染、颅脑外伤、核黄疸、中毒、脑变性病、脑血管病、营养不良、", "snippet_origin": "text", "source_sha256": "dd3b58dea0f4314f7660391779afad4db88425eb202556bd8511d5ed6aca994b", "status": "200", "structure": {"block_kinds": {"h": 1, "p": 19}, "html": {"chars": 0, "state": "empty", "visible_chars": 0}, "repeated_lines": 0, "title_body_word_overlap": 0.0}, "text_state": "present", "url": "http://www.cnkang.com/dise/108/335794.html", "verbatim_sha256": "04eee173656dfd6d8d5636ff08596b23bbb1ba39ba9758f1fae4ffa016f9dc0e"}, "sample_kind": "targeted_flag_example", "sampling_weight": null}
