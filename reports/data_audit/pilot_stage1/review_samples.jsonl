db", "review_status": "unreviewed", "row_group": 0, "row_offset": 33, "script_ratios": {"ascii_latin": 1330, "cjk": 0, "confidence": "heuristic_only", "letters": 1774, "scope": "entire_text", "vi_diacritic_chars": 328}, "shard": "ViBioMIR/shards/A/vov.vn/part-1792716842933-706.parquet", "signals": {"gate": {"count": 0, "examples": []}, "negation": {"count": 0, "examples": []}, "number_unit": {"count": 0, "examples": []}, "ui": {"count": 1, "examples": [{"end": 1059, "start": 1045, "text": "Privacy Policy"}]}}, "snippet": "Gắp thành công đỉa ký sinh trong mũi bé 8 tháng tuổi\nVOV.VN - Bệnh viện Đa khoa tỉnh Lạng Sơn vừa gắp thành công con đỉa ký sinh trong mũi bé 8 tháng tuổi.\nNgày 29/5, Bệnh viện Đa khoa tỉnh Lạng Sơn tiếp nhận trường hợp bệnh nhi H.V.T (8 tháng tuổi, ở xã Tràng Phái, huyện Văn Quan, tỉnh Lạng Sơn) trong tình trạng chảy máu mũi bên phải. Các bác sĩ Khoa Tai - Mũi - Họng đã thực hiện nội soi mũi cho bé và phát hiện một con đỉa dài khoảng 2cm ký sinh bên trong mũi bệnh nhi.\nDo con đỉa trơn và thường xuyên di động nên quá trình gắp con vật ra khỏi khoang mũi gặp nhiều khó khăn. Phải đến ngày 30/5, ", "snippet_origin": "text", "source_sha256": "c2221a7c3192fc96110806b713b8109cc7c63d77eb2d856bd6c45ab79bfdf625", "status": "200", "structure": {"block_kinds": {"h": 9, "p": 13}, "html": {"chars": 0, "state": "empty", "visible_chars": 0}, "repeated_lines": 6, "title_body_word_overlap": 1.0}, "text_state": "present", "url": "https://vov.vn/suc-khoe/nhi-khoa/gap-thanh-cong-dia-ky-sinh-trong-mui-be-8-thang-tuoi-post947390.vov", "verbatim_sha256": "b23048a1fdeee77eaa1a33ba429196cef1cddb33a5c3d3615de0ad40b0873e44"}, "sample_kind": "targeted_flag_example", "sampling_weight": null}
